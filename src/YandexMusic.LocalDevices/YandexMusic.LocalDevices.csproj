<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>YandexMusic.LocalDevices</PackageId>
    <Title>YandexMusic.LocalDevices</Title>
    <Description>Discovery of Yandex speakers on the local network (mDNS/DNS-SD), for the YandexMusic client. — Обнаружение колонок Яндекса в локальной сети для клиента Яндекс Музыки.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageTags>$(PackageTags);mdns;dns-sd;discovery;speakers</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YandexMusic.Tests" />
  </ItemGroup>

</Project>
